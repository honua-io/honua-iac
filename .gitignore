**/.terraform/
# Local operator inputs/state — terraform.tfvars contains secrets, never commit.
**/terraform.tfvars
# An activated backend names the operator's own state bucket and backend-access
# role. Copy backend.tf.example to backend.tf locally; never commit the result.
infrastructure/terraform/**/backend.tf
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
# Apply-time build artifacts for the aws-demo PostGIS bootstrap Lambda.
infrastructure/terraform/examples/aws-demo/postgis-bootstrap/build/
infrastructure/terraform/examples/aws-demo/postgis-bootstrap/bootstrap.zip
infrastructure/terraform/internal/gtm-forms-router/build/
scripts/tf-secrets.local.sh
scripts/tf-pass-insert.local.sh

# Local pinned tool downloads (terraform binary for agent worktrees).
.tools/
