{
  "schemaVersion": "v1",
  "name": "aws-live",
  "kind": "aws-live",
  "planArtifactRoot": "plans/aws",
  "bootstrapRoot": "bootstrap/aws",
  "bootstrapModules": {
    "ecs": {
      "sourcePath": "infrastructure/terraform/bootstrap/aws-ecs",
      "userNameTemplate": "honua-tf-ecs-{runId}-{runAttempt}"
    },
    "serverless": {
      "sourcePath": "infrastructure/terraform/bootstrap/aws-serverless",
      "userNameTemplate": "honua-tf-sls-{runId}-{runAttempt}"
    }
  },
  "targetDescriptors": {
    "ecs": {
      "outputs": {
        "baseUrl": [
          "deploy_contract.value.endpoint"
        ],
        "databaseHost": [
          "deployment_contract.value.dependencies.database.host"
        ],
        "databaseSecretRef": [
          "deploy_contract.value.secret_refs.database_connection.id"
        ],
        "cacheSecretRef": [
          "deploy_contract.value.secret_refs.redis_connection.id"
        ],
        "workloadName": [
          "deploy_contract.value.target_name"
        ],
        "clusterName": [
          "deployment_contract.value.workload.cluster_name"
        ],
        "currentRevision": [
          "deploy_contract.value.current_revision"
        ],
        "desiredRevision": [
          "deploy_contract.value.desired_revision"
        ],
        "deployTargetId": [
          "deploy_contract.value.target_id"
        ],
        "objectStorageEnabled": [
          "deploy_contract.value.object_storage_refs.enabled"
        ],
        "awsObjectStorageBucketName": [
          "deploy_contract.value.object_storage_refs.bucket_name"
        ],
        "awsObjectStoragePrefix": [
          "deploy_contract.value.object_storage_refs.prefix"
        ]
      }
    },
    "serverless": {
      "outputs": {
        "baseUrl": [
          "deploy_contract.value.endpoint"
        ],
        "databaseHost": [
          "deployment_contract.value.dependencies.database.host"
        ],
        "databaseSecretRef": [
          "deploy_contract.value.secret_refs.database_connection.id"
        ],
        "cacheSecretRef": [
          "deploy_contract.value.secret_refs.redis_connection.id"
        ],
        "workloadName": [
          "deploy_contract.value.target_name"
        ],
        "currentRevision": [
          "deploy_contract.value.current_revision"
        ],
        "desiredRevision": [
          "deploy_contract.value.desired_revision"
        ],
        "deployTargetId": [
          "deploy_contract.value.target_id"
        ],
        "objectStorageEnabled": [
          "deploy_contract.value.object_storage_refs.enabled"
        ],
        "awsObjectStorageBucketName": [
          "deploy_contract.value.object_storage_refs.bucket_name"
        ],
        "awsObjectStoragePrefix": [
          "deploy_contract.value.object_storage_refs.prefix"
        ]
      }
    }
  }
}
