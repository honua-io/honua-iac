# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it contains secrets.
#
# This file assigns every variable this root requires, so a copied and filled-in
# terraform.tfvars reaches `terraform plan` with nothing left unset. Values in
# CAPITALS are placeholders, never real or reusable secrets.
#
# For a single-node development cell, keep this file and add the non-secret size
# overlay, which wins for the variables it sets:
#
#   terraform plan -var-file=presets/small.tfvars.example
#
# Preset contract: docs/deployment-presets.md

location    = "eastus"
environment = "prod"
name_prefix = "honua"

# Functions-compatible container image. Pin the published digest. No v*
# honua-server tag exists (v1.2.x-aot and v1.5.0 are not releases). Replace
# the placeholder before apply. The module splits name@sha256:hex for the
# Functions docker site config.
honua_image = "ghcr.io/honua-io/honua-server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# 2026.1 contract. Disabled declares Licensing__Mode=Disabled. The server
# default is Enabled and would boot the Community edition. enable_pro_license
# forces Enabled. This stack is preview and is not a qualified 2026.1 target.
licensing_mode = "Disabled"

# Admin API password (minimum 32 characters).
# Generate: openssl rand -hex 32
honua_admin_password = "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"

# Required, fail-closed decision. Use null only for a brand-new deployment so
# Terraform generates an independent key. Before upgrading an existing deployment,
# replace null with its current key (historically the Honua admin password).
honua_connection_encryption_master_key = null

tags = {
  owner      = "platform"
  costCentre = "honua"
}
