# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it contains secrets.
#
# This file assigns every variable this root requires, so a copied and filled-in
# terraform.tfvars reaches `terraform plan` with nothing left unset. Values in
# CAPITALS are placeholders, never real or reusable secrets.
#
# For a single-node development cell, keep this file and add the non-secret size
# overlay, which wins for the variables it sets:
#
#   terraform plan -var-file=presets/small.tfvars.example
#
# Preset contract: docs/deployment-presets.md

region      = "us-west-2"
environment = "prod"
name_prefix = "honua"

# Lambda container image. It MUST be pushed to ECR — Lambda requires ECR and does
# not pull from GHCR directly. Prefer the AOT image (*-lambda-aot) for short cold
# starts; the *-lambda image is a debug fallback. Pin to an immutable tag/digest.
honua_image_uri = "123456789012.dkr.ecr.us-west-2.amazonaws.com/honua-server:v1.5.0-lambda-aot"

# Admin API password (minimum 32 characters).
# Generate: openssl rand -hex 32
honua_admin_password = "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"

# Leave unset (null) to let Terraform auto-generate the PostgreSQL password.
# db_password = null

tags = {
  Owner      = "platform"
  CostCentre = "honua"
}
