# Replace the illustrative sha256:aaaa... pins below with verified image digests before applying.
# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it contains secrets.
#
# This file assigns every variable this root requires, so a copied and filled-in
# terraform.tfvars reaches `terraform plan` with nothing left unset. Values in
# CAPITALS are placeholders, never real or reusable secrets.
#
# For a single-node development cell, keep this file and add the non-secret size
# overlay, which wins for the variables it sets:
#
#   terraform plan -var-file=presets/small.tfvars.example
#
# Preset contract: docs/deployment-presets.md

region      = "us-west-2"
environment = "prod"
name_prefix = "honua"

# Lambda container image. It MUST be pushed to ECR — Lambda requires ECR and does
# not pull from GHCR directly. Prefer the AOT image (*-lambda-aot) for short cold
# starts; the *-lambda image is a debug fallback. Pin to a SHA-256 digest.
honua_image_uri = "123456789012.dkr.ecr.us-west-2.amazonaws.com/honua-server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Admin API password (minimum 32 characters).
# Generate: openssl rand -hex 32
honua_admin_password = "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"

# Leave unset (null) to let Terraform auto-generate the PostgreSQL password.
# db_password = null

# ElastiCache Redis is enabled by default, and a Redis-connected server refuses to
# start without its operation key-ring certificate. Provision an operator-owned
# Secrets Manager secret separately containing base64 PKCS#12 with a private key,
# or JSON {pkcs12,password}, and keep it across replacements. Only the ARN goes
# here: the Lambda receives an aws:secretsmanager: reference and reads the value
# with its own role. Never put private material in this file.
# Replace this illustrative complete ARN with the separately provisioned secret.
operation_key_ring_certificate_secret_arn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:REPLACE_WITH_OPERATOR_KEYRING-ABC123"
# For a customer-managed encryption key, also supply its exact ARN. The module
# grants the Lambda roles decrypt; the key policy must permit those roles.
# operation_key_ring_certificate_secret_kms_key_arn = "arn:aws:kms:us-west-2:123456789012:key/00000000-0000-0000-0000-000000000001"

# Recommended for Production: an operator-owned Secrets Manager secret whose value
# is a base64 audit hash-chain key of at least 32 bytes (openssl rand -base64 32).
# Without it audit rows are still written but chain verification never succeeds and
# the audit-chain-integrity health check is Unhealthy. Set it at first install and
# keep it for the deployment's lifetime. Only the ARN goes here.
# audit_chain_key_secret_arn = "arn:aws:secretsmanager:REGION:123456789012:secret:REPLACE_WITH_AUDIT_CHAIN_KEY-ABC123"
# audit_chain_key_secret_kms_key_arn = "arn:aws:kms:REGION:123456789012:key/00000000-0000-0000-0000-000000000001"

# Production denies every typed operation (for example service.publish) until a
# rule allows it: Operations:Policy is enabled with DefaultDecision Deny. Rules
# are first-match-wins; decision is Allow, RequireApproval, DryRunFirst or Deny.
# operations_policy_rules = [
#   { operation_id = "service.publish", role = "admin", decision = "Allow" },
#   { role = "admin", decision = "RequireApproval", approval_lane = "control-plane" },
# ]

tags = {
  Owner      = "platform"
  CostCentre = "honua"
}
