# Replace the illustrative sha256:aaaa... pins below with verified image digests before applying.
# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it contains secrets.
#
# This file assigns every variable this root requires, so a copied and filled-in
# terraform.tfvars reaches `terraform plan` with nothing left unset. Values in
# CAPITALS are placeholders, never real or reusable secrets.
#
# For a single-node development cell, keep this file and add the non-secret size
# overlay, which wins for the variables it sets:
#
#   terraform plan -var-file=presets/small.tfvars.example
#
# Preset contract: docs/deployment-presets.md

region      = "us-east-1"
environment = "prod"
name_prefix = "honua"

# Container image to deploy to ECS/Fargate.
# Pin to an immutable release tag or digest.
honua_image = "ghcr.io/honua-io/honua-server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Admin API password (minimum 32 characters).
# Generate: openssl rand -hex 32
honua_admin_password = "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"

# Required, fail-closed decision. Use null only for a brand-new deployment so
# Terraform generates an independent key. Before upgrading an existing deployment,
# replace null with its current key (historically the Honua admin password).
honua_connection_encryption_master_key = null

# Leave unset (null) to let Terraform auto-generate the PostgreSQL password.
# db_password = null

# Optional custom hostname + Route53 zone for ACM-managed TLS and ALB alias DNS.
# domain_name     = "honua.example.com"
# route53_zone_id = "ZXXXXXXXXXXXXXXXXX"

# Optional: bring your own ACM certificate instead of Terraform-managed validation.
# alb_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"

# With HTTPS, redirect port 80 to HTTPS (default true); false closes port 80.
# alb_enable_http_redirect = true

# ElastiCache Redis (enabled by default; required for /healthz/ready in Production).
# redis_enabled = true

# Provision an operator-owned Secrets Manager secret separately containing base64
# PKCS#12 with a private key, or JSON {pkcs12,password}. Retain the certificate
# across replacements and stable/canary tasks; never put private material here.
# Replace this illustrative complete ARN with the separately provisioned secret.
operation_key_ring_certificate_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:REPLACE_WITH_OPERATOR_KEYRING-ABC123"
# For a customer-managed encryption key, also supply its exact ARN. The module
# grants execution-role read/decrypt; the key policy must permit that role.
# operation_key_ring_certificate_secret_kms_key_arn = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000001"

# Recommended for Production: an operator-owned Secrets Manager secret whose value
# is a base64 audit hash-chain key of at least 32 bytes (openssl rand -base64 32).
# Without it audit rows are still written but chain verification never succeeds and
# the audit-chain-integrity health check is Unhealthy. Set it at first install and
# keep it for the deployment's lifetime. Only the ARN goes here.
# audit_chain_key_secret_arn = "arn:aws:secretsmanager:REGION:123456789012:secret:REPLACE_WITH_AUDIT_CHAIN_KEY-ABC123"
# audit_chain_key_secret_kms_key_arn = "arn:aws:kms:REGION:123456789012:key/00000000-0000-0000-0000-000000000001"

# Safe single-instance is the default. To enable ECS HA or auto-scaling, set all
# of these together and provide an existing S3 bucket. The module grants its ECS
# task role access to that bucket; it does not create the bucket.
# deployment_mode                 = "MultiNode"
# desired_count                   = 2
# max_capacity                    = 4
# redis_enabled                   = true
# file_storage_provider           = "AwsS3"
# file_storage_aws_s3_bucket_name = "honua-prod-files"
# file_storage_aws_s3_region      = "us-east-1"

# Production denies every typed operation (for example service.publish) until a
# rule allows it: Operations:Policy is enabled with DefaultDecision Deny. Rules
# are first-match-wins; decision is Allow, RequireApproval, DryRunFirst or Deny.
# operations_policy_rules = [
#   { operation_id = "service.publish", role = "admin", decision = "Allow" },
#   { role = "admin", decision = "RequireApproval", approval_lane = "control-plane" },
# ]

tags = {
  Owner      = "platform"
  CostCentre = "honua"
}
