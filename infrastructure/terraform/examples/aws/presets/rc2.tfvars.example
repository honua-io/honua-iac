# Non-secret rc.2 ECS overlay; see ../RC2.md. Not an apply-ready release lock.
# Copy terraform.tfvars.example first, fill customer inputs, and supply verified
# server and PostgreSQL client digests separately. Never use the illustrative pins.
environment = "prod"
deployment_mode = "MultiNode"
# desired_count is the minimum task count. Raise it before an expected surge and
# apply; lower it afterwards. max_capacity bounds the database pool per task.
desired_count = 2
max_capacity = 6
autoscaling_requests_per_target = 600
db_instance_class = "db.t4g.medium"
# Needs a server release that keeps shared state in PostgreSQL; see ../RC2.md.
# For an earlier release set shared_state_backend = "redis" and redis_enabled = true.
shared_state_backend = "postgres"
redis_enabled = false
canary_enabled = false
file_storage_provider = "AwsS3"
file_storage_aws_s3_create_bucket = true
file_storage_aws_s3_bucket_name = ""
file_storage_aws_s3_region = ""
db_publicly_accessible = false
enable_postgis = true
alb_enable_http_redirect = false
allow_http_ingress_cidrs = []
# Customer tfvars must set domain_name, regional alb_certificate_arn and:
# cdn = { viewer_certificate_arn = <us-east-1 ACM ARN> }
# static_console = { viewer_certificate_arn = <the same ARN>, bundle_version = <verified release version> }
# postgis_bootstrap_image = <verified PostgreSQL client registry/repository@sha256:digest>
# Use an image containing psql, matching task_cpu_architecture. No database daemon runs in ECS.
