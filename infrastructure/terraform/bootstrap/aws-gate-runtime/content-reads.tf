locals {
  # Content APIs must not inherit the metadata-read exception. Unsupported
  # resource-tag conditions deliberately deny even gate requests.
  shared_content_read_actions = [
    "acm:GetCertificate",
    "acm:ExportCertificate",
    "acm:GetAcmeExternalAccountBindingCredentials",
    "backup:GetRecoveryPoint*",
    "backup:GetRestore*",
    "backup:DescribeRecoveryPoint",
    "backup:StartRestoreJob",
    "backup:StartCopyJob",
    "backup:Copy*",
    # DescribeJobD* is exactly DescribeJobDefinitions. DescribeJobQueues is queue
    # metadata (CloudFormation calls it on *); it must not inherit this fence.
    "batch:DescribeJobs",
    "batch:DescribeJobD*",
    "batch:DescribeServiceJob",
    "cloudfront:Get*",
    "cloudfront:List*",
    "ec2:GetPasswordData",
    "ec2:GetConsole*",
    "ec2:GetLaunchTemplateData",
    "ec2:GetInstanceUefiData",
    "ec2:GetVpnConnectionDeviceSampleConfiguration",
    "ec2:DescribeInstanceAttribute",
    "ec2:DescribeKeyPairs",
    "ec2:DescribeLaunchTemplateVersions",
    "ec2:DescribeVpnConnections",
    "ecs:ExecuteCommand",
    "ecs:DescribeTask*",
    "ecs:DescribeServiceRevisions",
    "ecs:DescribeDaemon*",
    "elasticloadbalancing:GetTrustStore*",
    "elasticloadbalancing:DescribeRules",
    "elasticloadbalancing:DescribeListeners",
    "elasticloadbalancing:DescribeLoadBalancerPolicies",
    "ecr:GetAuthorizationToken",
    "ecr:BatchGetImage",
    "ecr:GetDownloadUrlForLayer",
    "lambda:Get*",
    "lambda:List*",
    "logs:Get*",
    "logs:FilterLogEvents",
    "logs:StartQuery",
    "logs:StartLiveTail",
    "logs:ListAnomalies",
    "logs:DescribeAccountPolicies",
    "logs:DescribeQueries",
    "logs:DescribeQueryDefinitions",
    "logs:ListScheduledQueries",
    "rds:DescribeDBProxyTargetGroups",
    "rds:Download*",
    "rds:Copy*",
    "rds:Restore*",
    "rds:StartExportTask",
    "route53:ListResourceRecordSets",
    "route53:GetTrafficPolicy",
    "route53:ListTrafficPolicyVersions",
    "secretsmanager:GetSecretValue",
    "secretsmanager:BatchGetSecretValue",
    "wafv2:Get*",
    "wafv2:ListAPIKeys",
    "ce:GetCost*",
    "ce:GetDimensionValues",
    "ce:GetTags",
    "cloudtrail:LookupEvents",
    "cloudtrail:GetQueryResults",
    "cloudwatch:GetDashboard",
    "guardduty:GetFindings*",
    "kms:Decrypt",
    "kms:GenerateDataKey*",
    "kms:ReEncrypt*",
    "kms:Get*",
    "sns:GetSMSAttributes",
    "sns:ListPhoneNumbersOptedOut",
    "sqs:ReceiveMessage"
  ]
}
