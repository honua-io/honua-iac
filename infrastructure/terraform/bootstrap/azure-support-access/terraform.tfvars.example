# Copy to terraform.tfvars and fill in. Never commit the real file.

# Scope the roles to the resource group that holds your Honua deployment so
# support access can never reach unrelated resources. Subscription scope works
# too but is broader than recommended.
scope = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/honua-prod"

# Entra (Azure AD) object IDs Honua support provides. Prefer a Group object ID
# so Honua can manage membership without you re-applying Terraform.
principal_type = "Group"

observe_principal_object_ids = [
  "11111111-1111-1111-1111-111111111111",
]

break_glass_principal_object_ids = [
  "22222222-2222-2222-2222-222222222222",
]

# Read-only diagnostics are safe as a standing assignment (default true).
# create_observe_assignment = true

# Elevated remediation must be time-bounded. Leave this false (default) and make
# the break-glass principals PIM-eligible for the break-glass role so activation
# is per-ticket and auto-expires. Set true ONLY if your tenant lacks Entra PIM
# and you accept a standing elevated assignment you revoke manually.
# create_break_glass_assignment = false
