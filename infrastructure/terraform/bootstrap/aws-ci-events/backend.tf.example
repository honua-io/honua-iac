# Remote state for the CI events receiver. Copy to backend.tf (gitignored) and replace the bucket
# placeholder with the account's state bucket from bootstrap/aws-tfstate.
# `use_lockfile` needs Terraform >= 1.10; on 1.5-1.9 drop it and use the dynamodb_table line.
terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_STATE_BUCKET_NAME"
    key          = "bootstrap/aws-ci-events/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true

    # Terraform 1.5-1.9 fallback:
    # dynamodb_table = "honua-tfstate-lock"
  }
}
