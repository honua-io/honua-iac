{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Discovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ecs:Describe*",
        "ecs:List*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "elasticloadbalancing:Describe*",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:List*",
        "logs:Describe*",
        "tag:GetResources",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TaggedCreation",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateInternetGateway",
        "ec2:CreateNatGateway",
        "ec2:AllocateAddress",
        "ecs:CreateCluster",
        "ecs:CreateService",
        "ecs:RegisterTaskDefinition",
        "rds:CreateDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:CreateDBParameterGroup",
        "lambda:CreateFunction",
        "logs:CreateLogGroup",
        "secretsmanager:CreateSecret",
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateRule"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Owner": "release-cell"
        },
        "StringLike": {
          "aws:RequestTag/RunId": "?*"
        }
      }
    },
    {
      "Sid": "CellUpdates",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:UpdateClusterSettings",
        "rds:ModifyDBInstance",
        "rds:ModifyDBParameterGroup",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias",
        "lambda:AddPermission",
        "logs:PutRetentionPolicy",
        "secretsmanager:PutSecretValue",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:ModifyListener",
        "elasticloadbalancing:ModifyRule"
      ],
      "Resource": [
        "arn:aws:ecs:${region}:${account_id}:cluster/honuar*",
        "arn:aws:ecs:${region}:${account_id}:service/honuar*",
        "arn:aws:ecs:${region}:${account_id}:task-definition/honuar*",
        "arn:aws:lambda:${region}:${account_id}:function:honuar*",
        "arn:aws:rds:${region}:${account_id}:db:honuar*",
        "arn:aws:rds:${region}:${account_id}:subgrp:honuar*",
        "arn:aws:rds:${region}:${account_id}:pg:honuar*",
        "arn:aws:logs:${region}:${account_id}:log-group:honuar*",
        "arn:aws:secretsmanager:${region}:${account_id}:secret:honuar*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/honuar*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:targetgroup/honuar*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener/app/honuar*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener-rule/app/honuar*",
        "arn:aws:ecs:${region}:${account_id}:cluster/honuan*",
        "arn:aws:ecs:${region}:${account_id}:service/honuan*",
        "arn:aws:ecs:${region}:${account_id}:task-definition/honuan*",
        "arn:aws:lambda:${region}:${account_id}:function:honuan*",
        "arn:aws:rds:${region}:${account_id}:db:honuan*",
        "arn:aws:rds:${region}:${account_id}:subgrp:honuan*",
        "arn:aws:rds:${region}:${account_id}:pg:honuan*",
        "arn:aws:logs:${region}:${account_id}:log-group:honuan*",
        "arn:aws:secretsmanager:${region}:${account_id}:secret:honuan*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/honuan*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:targetgroup/honuan*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener/app/honuan*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener-rule/app/honuan*",
        "arn:aws:ecs:${region}:${account_id}:cluster/honuaeks*",
        "arn:aws:ecs:${region}:${account_id}:service/honuaeks*",
        "arn:aws:ecs:${region}:${account_id}:task-definition/honuaeks*",
        "arn:aws:lambda:${region}:${account_id}:function:honuaeks*",
        "arn:aws:rds:${region}:${account_id}:db:honuaeks*",
        "arn:aws:rds:${region}:${account_id}:subgrp:honuaeks*",
        "arn:aws:rds:${region}:${account_id}:pg:honuaeks*",
        "arn:aws:logs:${region}:${account_id}:log-group:honuaeks*",
        "arn:aws:secretsmanager:${region}:${account_id}:secret:honuaeks*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/honuaeks*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:targetgroup/honuaeks*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener/app/honuaeks*",
        "arn:aws:elasticloadbalancing:${region}:${account_id}:listener-rule/app/honuaeks*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "release-cell"
        },
        "Null": {
          "aws:ResourceTag/RunId": "false"
        }
      }
    },
    {
      "Sid": "NetworkUpdates",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:AttachInternetGateway"
      ],
      "Resource": "arn:aws:ec2:${region}:${account_id}:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Owner": "release-cell"
        },
        "Null": {
          "ec2:ResourceTag/RunId": "false"
        }
      }
    },
    {
      "Sid": "CreateBoundedRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::${account_id}:role/honuar*",
        "arn:aws:iam::${account_id}:role/honuan*",
        "arn:aws:iam::${account_id}:role/honuaeks*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Owner": "release-cell"
        },
        "StringLike": {
          "aws:RequestTag/RunId": "?*"
        },
        "ArnEquals": {
          "iam:PermissionsBoundary": "${boundary_arn}"
        }
      }
    },
    {
      "Sid": "ManageCellRolePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:TagRole"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/honuar*",
        "arn:aws:iam::${account_id}:role/honuan*",
        "arn:aws:iam::${account_id}:role/honuaeks*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Owner": "release-cell"
        },
        "Null": {
          "aws:ResourceTag/RunId": "false"
        }
      }
    },
    {
      "Sid": "PassCellRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${account_id}:role/honuar*",
        "arn:aws:iam::${account_id}:role/honuan*",
        "arn:aws:iam::${account_id}:role/honuaeks*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com",
            "lambda.amazonaws.com",
            "batch.amazonaws.com",
            "events.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TagNewNetworkResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:${region}:${account_id}:*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Owner": "release-cell"
        },
        "StringLike": {
          "ec2:CreateAction": "*",
          "aws:RequestTag/RunId": "?*"
        }
      }
    }
  ]
}
