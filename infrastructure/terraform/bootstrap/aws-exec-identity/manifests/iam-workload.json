{
  "id": "iam-workload",
  "kind": "shared",
  "module": null,
  "note": "Always attached. Name-prefix and permissions-boundary scope stay in the root, matching the certified role. This file is the action list only.",
  "region_actions": [],
  "global_actions": [],
  "pass_role_services": [],
  "service_linked_roles": [],
  "attachable_policies": [],
  "iam_statements": [
    {
      "sid": "AttachBoundedWorkloadPolicies",
      "resource_kind": null,
      "actions": [
        "iam:AttachRolePolicy"
      ]
    },
    {
      "sid": "CreateBoundedWorkloadRoles",
      "resource_kind": null,
      "actions": [
        "iam:CreateRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy"
      ]
    },
    {
      "sid": "CreateServiceLinkedRoles",
      "resource_kind": null,
      "actions": [
        "iam:CreateServiceLinkedRole"
      ]
    },
    {
      "sid": "ManageWorkloadRoles",
      "resource_kind": null,
      "actions": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:DeleteRole",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListPolicyVersions",
        "iam:ListRolePolicies",
        "iam:ListRoles",
        "iam:TagPolicy",
        "iam:TagRole",
        "iam:UntagPolicy",
        "iam:UntagRole"
      ]
    },
    {
      "sid": "PassWorkloadRoles",
      "resource_kind": null,
      "actions": [
        "iam:PassRole"
      ]
    }
  ],
  "covers": [
    "aws_iam_policy",
    "aws_iam_role",
    "aws_iam_role_policy",
    "aws_iam_role_policy_attachment"
  ],
  "simulate_allow": [
    "iam:CreateRole",
    "iam:PassRole"
  ]
}
