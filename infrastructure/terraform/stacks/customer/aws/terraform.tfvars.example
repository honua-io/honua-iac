region      = "us-east-1"
environment = "prod"
name_prefix = "honuaecs"

honua_image           = "ghcr.io/honua-io/honua-server:replace-me"
honua_admin_password  = "replace-with-32-plus-character-admin-password"
db_password           = "replace-with-database-password"

enable_postgis = true
redis_enabled  = true

tags = {
  environment = "prod"
  owner       = "platform"
  cost_center = "geo"
}
